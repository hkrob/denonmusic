<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Lets the app hand a downloaded update APK to the system installer - see app/update/. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      The now-playing notification and its transport buttons (app/notification/). It runs as a
      foreground service so the controls survive the app leaving the screen, which is the only time
      they are worth anything. FOREGROUND_SERVICE_MEDIA_PLAYBACK is the type Android 14+ requires
      to be declared alongside the service; POST_NOTIFICATIONS is only asked for from Android 13.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      allowBackup is off deliberately. Everything this app stores is either a LAN address or a
      password: the SMB share credentials and the LAN control token live in a plain (unencrypted)
      DataStore, so with backup enabled `adb backup` hands both to anyone with USB access to an
      unlocked phone. There is nothing here worth restoring anyway - the settings are a handful of
      fields, and every other table is a cache that refills itself from the network or the share.
    -->
    <application
        android:name=".DenonMusicApp"
        android:allowBackup="false"
        android:icon="@android:drawable/ic_media_play"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Not exported: nothing outside the app has any business driving it, and its actions arrive
          as explicit intents from the notification's own PendingIntents.
        -->
        <service
            android:name=".notification.NowPlayingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Hands a downloaded update APK (cache/updates) to the system installer read-only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
